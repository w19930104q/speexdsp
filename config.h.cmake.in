/* config.h generated by the CMake build of speexdsp.
   Mirrors the autoheader-generated config.h from the autotools build. */

#ifndef SPEEXDSP_CMAKE_CONFIG_H
#define SPEEXDSP_CMAKE_CONFIG_H

#define PACKAGE_NAME "speexdsp"
#define PACKAGE_VERSION "@SPEEXDSP_VERSION@"
#define PACKAGE_STRING "speexdsp @SPEEXDSP_VERSION@"

/* Use C99 variable-size arrays */
#cmakedefine VAR_ARRAYS 1

/* Compile as fixed-point */
#cmakedefine FIXED_POINT 1

/* Compile as floating-point */
#cmakedefine FLOATING_POINT 1

/* Use KISS Fast Fourier Transform */
#cmakedefine USE_KISS_FFT 1

/* Use FFT from OggVorbis */
#cmakedefine USE_SMALLFT 1

/* Enable SSE support */
#cmakedefine USE_SSE 1

/* Enable SSE2 support */
#cmakedefine USE_SSE2 1

/* Enable NEON support */
#cmakedefine USE_NEON 1

/* Disable all parts of the API that are using floats */
#cmakedefine DISABLE_FLOAT_API 1

/* Debug fixed-point implementation */
#cmakedefine FIXED_DEBUG 1

/* Resample with full SINC table (no interpolation) */
#cmakedefine RESAMPLE_FULL_SINC_TABLE 1

/* Symbol visibility prefix */
#define EXPORT @EXPORT@

#endif /* SPEEXDSP_CMAKE_CONFIG_H */
